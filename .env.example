# Copy to .env.local and fill in locally. Never commit real values.
# Every variable the project reads is listed here, with a short comment and no value.

# Contact form (ADR-0007). All server-only except the Turnstile site key.
# Resend API key restricted to sending, for the felpsxp.com domain only.
RESEND_API_KEY=
# Sender shown in the delivered e-mail, on a domain verified in Resend,
# for example: FelpsXP Hub <site@felpsxp.com>
CONTACT_FROM_EMAIL=
# Inbox that receives the messages; kept out of the repository.
CONTACT_TO_EMAIL=
# Cloudflare Turnstile. For local development and Vercel previews, use Cloudflare's
# public test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
